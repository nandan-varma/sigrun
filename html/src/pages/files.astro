const STATUS: Record<string, string> = {
  WORK: "work",
  SCAFF: "scaf",
  DEAD: "dead",
};
const STATUS_TEXT: Record<string, string> = {
  WORK: "REAL",
  SCAFF: "SCAFFOLD",
  DEAD: "INACTIVE",
};
---

<BaseLayout title="File index" description="Every Rust file in the SIGRUN repository, one line each, grouped by subsystem with an honest scaffold-vs-real status.">
  <p class="eyebrow">Reference · file index</p>
  <h1>Every file, one line each</h1>
  <p class="lede">
    All 82 Rust files in the repository. Use this as the index: when an interviewer names a file, you should be
    able to say what it does and whether it is real, scaffolded, or inactive.
  </p>

  <p><span class="badge work">REAL</span> does something real at boot or is exercised in tests ·
  <span class="badge scaf">SCAFFOLD</span> real shape, not wired to the running system ·
  <span class="badge dead">INACTIVE</span> compiled out, stubbed, or on an abandoned path.</p>

  <div class="callout">
    <span class="label">How to read the statuses</span>
    A file being marked SCAFFOLD is not criticism — it's the difference between "compiles and is tested as a
    data structure" (most of IPC and capabilities) and "drives hardware at boot" (boot, memory, scheduler,
    timers, interrupts, syscalls). In an interview, the strongest line is: "the kernel core is live; the
    peripheral servers are designed, compiled, and tested as structures, and my next milestone is spawning
    them."
  </div>

  {
    FILES.map((group) => (
      <section>
        <h2>{group.group}</h2>
        <table>
          <tr><th>File</th><th>Lines</th><th>Status</th><th>What it is</th></tr>
          {
            group.rows.map((r) => (
              <tr>
                <td class="mono">{r.f}</td>
                <td class="mono">{r.n}</td>
                <td><span class:list={["badge", STATUS[r.s]]}>{STATUS_TEXT[r.s]}</span></td>
                <td>{r.d}</td>
              </tr>
            ))
          }
        </table>
      </section>
    ))
  }

