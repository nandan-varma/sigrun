import BaseLayout from "../layouts/BaseLayout.astro";

// Every Rust file in the repo, one line each, grouped by subsystem.
// Status: WORK = does something real at boot or in tests · SCAFF = shape only
//          DEAD = compiled out / stub.
const FILES = [
